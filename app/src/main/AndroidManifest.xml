<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- 用来判断「现在是不是停在桌面上」，决定要不要暂停播放 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Overlay Permission for Warning Window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Boot Permission for Auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 让监控服务不被系统的省电策略回收 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="电视时间管家"
        android:banner="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvLimit">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="电视时间管家"
            android:theme="@style/Theme.TvLimit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只在「服务没被系统真正拉起」时由看门狗打开，用来把应用顶到前台再启动服务；
             不显示任何内容，也不留在最近任务里 -->
        <activity
            android:name=".ui.WakeupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity android:name=".ui.AdminActivity" />
        <activity android:name=".ui.DiagnosticsActivity" />
        <activity android:name=".ui.QuizSettingsActivity" />
        <activity android:name=".ui.EditProfileActivity" />
        <activity android:name=".ui.ProfileSelectionActivity" />
        <!-- singleTop：孩子狂按遥控器时不要堆出一摞拦截页；不留在最近任务里 -->
        <activity
            android:name=".ui.AppBlockedActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TvLimit" />
        <activity android:name=".ui.AppSelectionActivity" />
        <activity
            android:name=".ui.ParentGateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TvLimit" />

        <service
            android:name=".service.TimeTrackingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="usage_tracking" />
        </service>

        <!-- 看门狗：每 15 分钟确认一次监控服务还活着 -->
        <service
            android:name=".service.WatchdogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.HTC_QUICKBOOT_POWERON" />
                <!-- 覆盖安装新版本后也要把服务叫回来 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.AdminReceiver"
            android:description="@string/admin_description"
            android:label="电视时间管家（设备管理）"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
