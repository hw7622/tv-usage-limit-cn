<?xml version="1.0" encoding="utf-8"?>
<!--
  拦截页的「悬浮窗版本」。
  和 activity_app_blocked.xml 同一套视觉，但它是 WindowManager 直接加的窗口，
  不依赖后台启动 Activity —— 到点那一刻立刻可见，不用等系统放行。

  排版优先级和整机休息页保持一致：① 还要休息多久（最大的字）② 为什么被拦 ③ 家长入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appBlockedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/sun"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvAppBlockedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="这个应用现在不能看"
        android:textColor="@color/text_main"
        android:textSize="44sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <!-- 剩余休息时间：整页最重要的信息，数字给到 110sp -->
    <LinearLayout
        android:id="@+id/appBlockedRestBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="还 要 休 息"
            android:textColor="@color/text_sub"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppBlockedRestMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:minWidth="140dp"
                android:text="20"
                android:textColor="@color/sun"
                android:textSize="96sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="13dp"
                android:includeFontPadding="false"
                android:text="分"
                android:textColor="@color/text_sub"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvAppBlockedRestSec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="end"
                android:includeFontPadding="false"
                android:minWidth="120dp"
                android:text="00"
                android:textColor="@color/sun"
                android:textSize="96sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="13dp"
                android:includeFontPadding="false"
                android:text="秒"
                android:textColor="@color/text_sub"
                android:textSize="30sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAppBlockedDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="休息一下，等会儿再来吧"
        android:textColor="@color/text_sub"
        android:textSize="24sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_marginTop="34dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAppBlockedHome"
            style="@style/Widget.GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:minWidth="220dp"
            android:text="回到首页" />

        <Button
            android:id="@+id/btnAppBlockedParent"
            style="@style/Widget.BigButton"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginStart="24dp"
            android:minWidth="220dp"
            android:text="我是家长" />
    </LinearLayout>

</LinearLayout>
