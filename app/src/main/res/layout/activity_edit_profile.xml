<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="44dp"
    android:paddingBottom="36dp">

    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="儿童"
        android:textColor="@color/text_main"
        android:textSize="36sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tvProfileHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="用遥控器左右键调整，改完记得按保存"
        android:textColor="@color/text_dim"
        android:textSize="19sp"
        android:includeFontPadding="false" />

    <!-- 每天最多能看 -->
    <LinearLayout
        android:id="@+id/rowDaily"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/selector_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="每天最多能看"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnDailyMinus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusRight="@id/btnDailyPlus" />

        <TextView
            android:id="@+id/tvDailyValue"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="90 分钟"
            android:textColor="@color/sun"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnDailyPlus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusLeft="@id/btnDailyMinus" />
    </LinearLayout>

    <!-- 一次连续看多久 -->
    <LinearLayout
        android:id="@+id/rowSession"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/selector_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一次最多看"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnSessionMinus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusRight="@id/btnSessionPlus" />

        <TextView
            android:id="@+id/tvSessionValue"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="20 分钟"
            android:textColor="@color/sun"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnSessionPlus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusLeft="@id/btnSessionMinus" />
    </LinearLayout>

    <!-- 看完休息多久 -->
    <LinearLayout
        android:id="@+id/rowRest"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/selector_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="看完休息"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnRestMinus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusRight="@id/btnRestPlus" />

        <TextView
            android:id="@+id/tvRestValue"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="20 分钟"
            android:textColor="@color/sun"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnRestPlus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_stepper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:nextFocusLeft="@id/btnRestMinus" />
    </LinearLayout>

    <!-- 受限应用 -->
    <LinearLayout
        android:id="@+id/cardApps"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/selector_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="只限制这些应用"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvAppsSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="不限应用"
            android:textColor="@color/sky"
            android:textSize="22sp"
            android:includeFontPadding="false" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_faint"
            android:contentDescription="@null" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:minWidth="160dp"
            android:text="取消" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.BigButton"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginStart="20dp"
            android:minWidth="220dp"
            android:text="保存" />
    </LinearLayout>

</LinearLayout>
