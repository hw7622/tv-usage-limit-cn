<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="44dp"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="限制哪些应用"
        android:textColor="@color/text_main"
        android:textSize="36sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="勾选的应用单独计时，时间用完就打不开；一个都不勾就是整台电视限时"
        android:textColor="@color/text_dim"
        android:textSize="19sp"
        android:includeFontPadding="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        android:scrollbars="none" />

    <Button
        android:id="@+id/btnDone"
        style="@style/Widget.BigButton"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_gravity="end"
        android:minWidth="240dp"
        android:text="选好了" />

</LinearLayout>
