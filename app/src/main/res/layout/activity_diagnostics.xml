<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="30dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="运行诊断"
        android:textColor="@color/text_main"
        android:textSize="32sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="监控一旦被打断，这里能看到断了几次、断了多久"
        android:textColor="@color/text_dim"
        android:textSize="19sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:background="@drawable/selector_card"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日中断"
                android:textColor="@color/text_dim"
                android:textSize="17sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvGapCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 次"
                android:textColor="@color/mint"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/selector_card"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="累计时长"
                android:textColor="@color/text_dim"
                android:textSize="17sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvGapTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 秒"
                android:textColor="@color/mint"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/selector_card"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最近心跳"
                android:textColor="@color/text_dim"
                android:textSize="17sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvLastTick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="—"
                android:textColor="@color/sky"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStateLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        android:includeFontPadding="false" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_card">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_dim"
                android:textIsSelectable="false"
                android:textSize="14sp"
                android:typeface="monospace"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_btn_ghost"
            android:focusable="true"
            android:text="刷新"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/selector_btn_primary"
            android:focusable="true"
            android:text="导出日志"
            android:textColor="#241A02"
            android:textSize="19sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/selector_btn_ghost"
            android:focusable="true"
            android:text="返回"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
