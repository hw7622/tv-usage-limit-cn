<?xml version="1.0" encoding="utf-8"?>
<!--
    TCL 真机是 1080x608、density=1.0，一屏只有 608dp。
    五张卡片 + 按钮行本来就贴着底部，再加一张必然溢出 ——
    所以整页套一层 ScrollView 兜底：真放不下时遥控器移动焦点，系统会自动滚动到可见位置。
    卡片高度同时压到 68dp，正常情况下一屏能全看到，不用滚。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="答题门禁"
            android:textColor="@color/text_main"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:text="每看一段时间弹一组题，一组全答对才能接着看。到点该休息时休息优先，不另外弹题。"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <!-- 开关 -->
        <LinearLayout
            android:id="@+id/cardQuizSwitch"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="开启答题"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuizSwitchSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="关着的时候和以前一样，只按时间管"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizSwitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="已关闭"
                android:textColor="@color/coral"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 间隔 -->
        <LinearLayout
            android:id="@+id/cardQuizInterval"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="每隔多久答一组"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="只算真的在看的时间，桌面和休息不算"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizIntervalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="10 分钟"
                android:textColor="@color/sun"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 题量 -->
        <LinearLayout
            android:id="@+id/cardQuizCount"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="每次答几道题"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="必须全部答对；答错还会追加题目"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="3 道"
                android:textColor="@color/lavender"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 年级 -->
        <LinearLayout
            android:id="@+id/cardQuizGrade"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="题目年级"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="数学按年级生成，其他科目从题库选相近年级"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizGradeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="二年级"
                android:textColor="@color/sky"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 科目 -->
        <LinearLayout
            android:id="@+id/cardQuizSubjects"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="出题科目"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="可以多选，至少留一科"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizSubjectsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="数学"
                android:textColor="@color/mint"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 手机配置：电视上开个局域网网页，手机浏览器改题库 -->
        <LinearLayout
            android:id="@+id/cardQuizWeb"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="手机配置题库"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="手机连同一个 WiFi，浏览器打开就能加题、改设置"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizWebValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="未开启"
                android:textColor="@color/sun"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuizMistakes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>

    <!-- 底部按钮固定在屏幕底部，不跟着内容滚。
         961x541dp 那种小屏电视上，六行卡片一定装不下；按钮如果留在滚动区里，
         家长根本不知道下面还有东西。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnQuizClearMistakes"
            style="@style/Widget.GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/footer_h"
            android:minWidth="200dp"
            android:text="清空错题记录" />

        <TextView
            android:id="@+id/btnQuizPreview"
            style="@style/Widget.GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/footer_h"
            android:layout_marginStart="14dp"
            android:minWidth="200dp"
            android:text="现在答一组试试"
            android:textColor="@color/sun" />
    </LinearLayout>
</LinearLayout>
