<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="48dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="家长设置"
        android:textColor="@color/text_main"
        android:textSize="38sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="点上面的名字改时长和应用，下面是常用开关"
        android:textColor="@color/text_dim"
        android:textSize="19sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:id="@+id/profileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="32dp"
        android:orientation="vertical" />

    <!-- 底部三张工具卡：横排，节省竖向空间留给档案列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- 临时关闭限时 -->
        <LinearLayout
            android:id="@+id/cardPause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_timer"
                android:tint="@color/sky"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="临时关闭限制"
                android:textColor="@color/text_main"
                android:textSize="21sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvPauseState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="家长想自己看一会儿时用"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 角落倒计时开关 -->
        <LinearLayout
            android:id="@+id/cardBadge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_clock"
                android:tint="@color/mint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="角落倒计时"
                android:textColor="@color/text_main"
                android:textSize="21sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvBadgeState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="不显示"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 修改家长密码 -->
        <LinearLayout
            android:id="@+id/cardChangePassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/lavender"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="修改家长密码"
                android:textColor="@color/text_main"
                android:textSize="21sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="改成自己好记的 4 位数"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 后台保活 -->
        <LinearLayout
            android:id="@+id/cardKeepAlive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_check"
                android:tint="@color/sun"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="后台常驻"
                android:textColor="@color/text_main"
                android:textSize="21sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvKeepAliveState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="检查中…"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
